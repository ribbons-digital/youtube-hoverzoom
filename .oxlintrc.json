{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "vitest/require-mock-type-parameters": "off"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["dist", "node_modules", ".pnpm-store"]
}
